# ---- Node / client ----
node_modules/
client/dist/
client/.vite/
*.local

# Brand imagery IS committed, so a clone is a working site without waiting on Unsplash and
# without the renditions having to be rebuilt. `npm run media` refreshes it in place.

# ---- .NET / server ----
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# Serilog rolling files
server/Gym.Api/logs/

# Owner-uploaded media is runtime data, not source.
server/Gym.Api/wwwroot/media/uploads/
# Members' progress photos — private by construction, and never in version control.
server/Gym.Api/private-media/

# ---- Secrets ----
# appsettings.Development.json currently carries only sandbox/dev placeholders. Move real
# Razorpay and Anthropic keys into user secrets (dotnet user-secrets) before going live.
**/appsettings.Production.json
*.pfx
.env
.env.*

# ---- OS ----
Thumbs.db
Desktop.ini
.DS_Store

# Screenshots from `npm run audit:admin` — a debugging artefact, not source.
.audit-shots/
